# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/titife_jobs?schema=public"

# Worker configuration (AGENTS.md §2 defaults)
MAX_ATTEMPTS=5
WORKER_CONCURRENCY=5
BACKOFF_BASE_MS=2000
BACKOFF_CAP_MS=30000
STUCK_JOB_TIMEOUT_MS=300000
POLL_INTERVAL_MS=1000
SWEEP_INTERVAL_MS=60000
RESEND_REQUEST_TIMEOUT_MS=30000

# Resend API configuration
RESEND_API_KEY="re_placeholder_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"
